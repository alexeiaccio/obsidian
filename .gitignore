# npm
node_modules

# Don't include the compiled main.js file in the repo.
# It is built locally and attached to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json
.vite
.vp

# The lockfile is generated against the registry that serves @eoa/*, which is
# not public; a committed one would pin paths this machine cannot see.
pnpm-lock.yaml

# Intellij
*.iml
.idea

# Exclude macOS Finder (System Explorer) View States
.DS_Store
